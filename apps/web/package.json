{
  "name": "@qms-passport/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build:deps": "pnpm --filter @qms-passport/chain-config --filter @qms-passport/sdk run build",
